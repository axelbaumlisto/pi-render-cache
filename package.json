{
  "name": "pi-render-cache",
  "version": "1.0.3",
  "description": "Cuts pi coding-agent TUI CPU during streaming from ~105% of a core to ~10-16% by memoizing Intl.Segmenter (ICU grapheme segmentation) and incrementally caching Markdown.render",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "performance",
    "tui",
    "markdown",
    "intl-segmenter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/axelbaumlisto/pi-render-cache.git"
  },
  "files": [
    "extensions/index.ts",
    "src/*.js",
    "scripts/check-upstream.mjs",
    "scripts/resolve-pi.mjs",
    "compatibility.json",
    "assets/screenshot.png",
    "docs/UPSTREAM_STATUS.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/axelbaumlisto/pi-render-cache/main/assets/screenshot.png"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:perf": "npm run benchmark -- --blocks 3 --output .bench-results/test-perf.json && node scripts/evaluate-benchmark.mjs --input .bench-results/test-perf.json --min-blocks 3",
    "compat": "node scripts/check-upstream.mjs",
    "compat:matrix": "node scripts/install-fixture.mjs --all --check",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:evaluate": "node scripts/evaluate-benchmark.mjs",
    "premise": "node scripts/benchmark.mjs --blocks 20 --output .bench-results/premise-raw.json && node scripts/evaluate-benchmark.mjs --mode premise --input .bench-results/premise-raw.json",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run compat && npm run check-pack",
    "check-pack": "node scripts/check-pack.mjs",
    "release:feasibility": "node scripts/release-feasibility.mjs",
    "check": "npm run verify",
    "prepublishOnly": "npm run verify"
  }
}
